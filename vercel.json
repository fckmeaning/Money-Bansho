{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:deploy",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/welcome", "permanent": false },
    { "source": "/dashboard/", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/stocks", "destination": "/dashboard.html" },
    { "source": "/stocks/:symbol", "destination": "/dashboard.html" },
    { "source": "/story", "destination": "/dashboard.html" },
    { "source": "/dossier", "destination": "/dossier.html" },
    { "source": "/welcome", "destination": "/welcome.html" },
    { "source": "/forecast", "destination": "/forecast.html" },
    { "source": "/pages", "destination": "/pages.html" },
    { "source": "/terminal", "destination": "/terminal.html" },
    { "source": "/embed", "destination": "/embed.html" },
    {
      "source": "/api/:domain(aviation|climate|conflict|consumer-prices|cyber|economic|forecast|giving|health|imagery|infrastructure|maritime|military|natural|positive-events|prediction|radiation|research|resilience|safety|sanctions|scorecard|seismology|supply-chain|thermal|trade|unrest|webcam|wildfire)/v1/:rpc",
      "destination": "/api/domain-gateway?bansho_domain=:domain&bansho_rpc=:rpc"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(dashboard|dossier|terminal|welcome|forecast|pages|dashboard\\.html|dossier\\.html|terminal\\.html|welcome\\.html|forecast\\.html|pages\\.html|sw\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
